---
const {
  titel = "Ingen skal stå alene",
  tekst = [],
  knapTekst = "Se vores rådgivning",
  link = "#omos",
  logoTekst = "RO",
} = Astro.props;
---

<section class="intro">
  <div class="container intro-grid">

    <div>
      <h2>{titel}</h2>

      {tekst.map((afsnit: string) => (
        <p>{afsnit}</p>
      ))}

      <a href={link} class="knap lys">
        {knapTekst}
      </a>
    </div>

    <div class="logo-stor">
      {logoTekst}
    </div>

  </div>
</section>
<style>

  /* INTRO */

  .intro {
    background: var(--green);
    color: white;
    padding: 5rem 0;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .logo-stor {
    font-size: 7rem;
    text-align: center;
  }
  h2{
    font-family: 'Patrick Hand';
    text-transform: uppercase;
    font-style: italic;
    font-size: 3.5rem;
  }
  p {
    max-width: 430px;
    font-family: 'DM Sans', sans-serif;
  }
</style>