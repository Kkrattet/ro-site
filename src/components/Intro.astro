---
import logo2 from "../assets/RO-LYS.svg";

const {
  id,
  titel = "Ingen skal stå alene",
  tekst = [],
  knapTekst,
  link = "#omos",
} = Astro.props;
---

<section id={id} class="intro">
  <div class="container intro-grid">

    <div>
      <h2>{titel}</h2>

      {tekst.map((afsnit: string) => (
        <p>{afsnit}</p>
      ))}

      {knapTekst && (
        <a href={link} class="knap lys">
          {knapTekst}
        </a>
      )}
    </div>

    <div class="logo-stor">
      <a href="/" class="logo">
        <img src={logo2.src} alt="RO logo" />
      </a>
    </div>

  </div>
</section>

<style>

  /* INTRO */

  .intro {
    background: var(--green);
    color: white;
    padding: 5rem 0;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .logo-stor {
    font-size: 7rem;
    text-align: center;
  }
  h2{
    font-family: "Caveat";
font-optical-sizing: auto;
font-weight: 1000;
    text-transform: uppercase;
    font-style: italic;
    font-size: 3.5rem;
  }

  p {
  max-width: 430px;
  font-family: "Open Sans", sans-serif;
}
  @media (max-width: 700px) {
  .intro-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .logo-stor img {
    max-width: 200px;
    margin-inline: auto;
  }

  h2 {
    font-size: 2.5rem;
  }
}
</style>