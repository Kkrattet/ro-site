---
import logo from "../assets/RO.svg";
---

<header>
  <div class="header-indhold">

  <a href="/" class="logo">
  <img src={logo.src} alt="RO logo" />
</a>

    <nav>
      <a href="/help">
        Hjælp
      </a>
      <a href="/spejlet">
  Spejlet
</a>

     <a href="/about">
  Om os
</a>

      <a href="/contact">
  Kontakt
</a>
    </nav>

  </div>
</header>

<style>
  header {
    position: absolute;
    z-index: 10;
    top: 0;
    left: 0;

    width: 100%;

    padding: 1.5rem 0;

    color: white;
  }

  .header-indhold {
    width: min(90%, 1100px);
    margin-inline: auto;

    display: flex;
    justify-content: space-between;
    align-items: center;
  }

 .logo img {
  width: 55px;
  height: auto;
}

  nav {
    display: flex;
    gap: 2rem;
  }

  nav a {
    color: white;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.8rem;
    font-family: "Open Sans", sans-serif;
  }

  @media (max-width: 600px) {
    nav {
      gap: 1rem;
    }

    nav a {
      font-size: 0.7rem;
    }
  }
</style>