---
const {
  tekst
} = Astro.props;
---

<section class="citat">

  <div class="citat-indhold">

    <p>
      {tekst}
    </p>

    <a href="#" class="knap">
      Læs mere
    </a>

  </div>

</section>

<style>
  .citat {
    padding: 5rem 1.5rem;

    background: #ed7939;
    color: white;

    text-align: center;
  }

  .citat-indhold {
    max-width: 800px;
    margin-inline: auto;
  }

  p {
    margin-bottom: 1.5rem;

    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-style: italic;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .knap {
    display: inline-block;

    padding: 0.5rem 1rem;

    background: #244b32;
    color: white;

    text-decoration: none;
    text-transform: uppercase;

    font-size: 0.65rem;
    font-weight: bold;
  }
</style>