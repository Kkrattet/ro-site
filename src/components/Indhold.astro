---
import Advisor from "./Advisor.astro";
import Slideshow from "./Slideshow.astro";

const {
  titel,
  tekst = [],
  billede,
  alt = "",
  slideshow = false,
  advisor = false,
  knapTekst,
  link = "#",
  baggrund = "lys",
  omvendt = false,
  lysKnap = false,
} = Astro.props;

const baggrundClass = `${baggrund}-baggrund`;
const knapClass = lysKnap ? "knap lys" : "knap";
---

<section class={`indhold ${baggrundClass}`}>

  <div class={`container indhold-grid ${omvendt ? "omvendt" : ""}`}>

    {omvendt && (
      advisor ? (
        <Advisor />
      ) : slideshow ? (
        <Slideshow />
      ) : (
        <img src={billede} alt={alt} />
      )
    )}

    <div class="tekst">

      <h2>{titel}</h2>

      {tekst.map((afsnit: string) => (
        <p>{afsnit}</p>
      ))}
{knapTekst && (
  <a href={link} class={knapClass}>
    {knapTekst}
  </a>
)}

    </div>

    {!omvendt && (
      advisor ? (
        <Advisor />
      ) : slideshow ? (
        <Slideshow />
      ) : (
        <img src={billede} alt={alt} />
      )
    )}

  </div>

</section>

<style>
  .indhold {
    padding: 6rem 0;
  }

  .indhold-grid {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 5rem;
  align-items: center;
}

.indhold-grid.omvendt {
  grid-template-columns: 0.7fr 1.3fr;
}
.indhold-grid img {
  width: 448;
  height: 636;
}


  .indhold h2 {
    font-size: 2rem;
    font-family: "Lexend Exa", sans-serif;
  font-optical-sizing: auto;
  font-style: normal;
  
  }
  .indhold p {
  font-family: "Open Sans", sans-serif;
}

  .lys-baggrund {
    background: var(--lys-green);
    color: var(--green);
  }

  .green-baggrund {
    background: var(--green);
    color: white;
  }

  .orange-baggrund {
    background: var(--orange);
    color: white;
  }
</style>