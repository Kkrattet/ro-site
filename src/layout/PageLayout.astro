---
import "../styles/global.css"
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {title, headline, text}= Astro.props;
---


<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Lexend+Exa:wght@100..900&family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Patrick+Hand&display=swap" rel="stylesheet">

    <title>{title}</title>
  </head>
  <body>
    <Header headline={headline} text={text}/>
    <slot/>
     <Footer />
  </body>

</html>