---

import Tilbud from "../components/Tilbud.astro";
import Citat from "../components/Citat.astro";
import Indhold from "../components/Indhold.astro";
import PageLayout from "../layout/PageLayout.astro";
import  Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro"
---

 <PageLayout>
    <main>

      <Hero
  titelLinje1="Pårørende"
  titelLinje2="til misbrug"
  undertitel="– hvad gør du nu?"
  tekst="Rådgivningen Orfeus tilbyder gratis rådgivning til dig, der er pårørende til en person med et misbrug."
  knapTekst="Læs mere"
  link="#omos"
/>


     <Intro
  titel="Ingen skal stå alene"
  tekst={[
    "Er du tæt på en person, der har et problematisk forbrug eller et misbrug?",
    "Hos Rådgivningen Orfeus kan du få gratis og anonym rådgivning."
  ]}
  knapTekst="Se vores rådgivning"
  link="#omos"
  logoTekst="RO"
/>

      <!-- TILBUD -->
      <section
        class="tilbud-sektion"
        id="omos"
      >
        <div class="container tilbud-grid">

          <Tilbud
            titel="Online"
            billede="/images/online.jpg"
          >
            Få rådgivning online, hvis du gerne vil kunne
            deltage hjemmefra.
          </Tilbud>

          <Tilbud
            titel="Individuelt"
            billede="/images/individuel.jpg"
          >
            Få en individuel samtale med fokus på dig og
            din situation.
          </Tilbud>

          <Tilbud
            titel="Gruppe"
            billede="/images/gruppe.jpg"
          >
            Mød andre pårørende og del erfaringer i et
            trygt fællesskab.
          </Tilbud>

        </div>
      </section>


      <!-- CITAT -->
      <Citat
        tekst="Ikke alle mennesker ved, at de er pårørende."
      />
<!-- KENDER DU DET -->
<Indhold
  titel="Kender du det?"
  tekst={[
    "Måske fylder din pårørendes misbrug mere og mere i din hverdag.",
    "Det kan være svært at vide, hvad man skal gøre, og hvor grænsen går mellem at hjælpe og samtidig passe på sig selv."
  ]}
  billede="/images/kender-du-det.jpg"
  alt="Person i naturen"
  knapTekst="Læs mere"
  baggrund="lys"
/>


<!-- RÅD OG TIPS -->
<Indhold
  titel="Få råd og tips"
  tekst={[
    "Som pårørende kan det være svært at finde ud af, hvordan man bedst håndterer situationen.",
    "Vi har samlet forskellige råd, som måske kan hjælpe dig."
  ]}
  billede="/images/tips.jpg"
  alt="Skygge på en væg"
  knapTekst="Læs mere"
  baggrund="green"
  omvendt
  lysKnap
/>


<!-- HISTORIER -->
<Indhold
  titel="Personlige historier"
  tekst={[
    "Andre pårørende har stået i situationer, der måske minder om din.",
    "Her kan du læse deres historier og erfaringer."
  ]}
  billede="/images/historier.jpg"
  alt="Personlig historie"
  knapTekst="Læs historier"
  baggrund="orange"
/>


<!-- OM FORENINGEN -->
<Indhold
  titel="Om foreningen"
  tekst={[
    "Rådgivningen Orfeus arbejder for, at pårørende til mennesker med misbrug ikke skal stå alene."
  ]}
  billede="/images/foreningen.jpg"
  alt="Rådgivningen Orfeus"
  knapTekst="Læs mere"
  baggrund="lys"
  omvendt
/>


<!-- RÅDGIVERE -->
<Indhold
  titel="Mød rådgiverne"
  tekst={[
    "Vores rådgivere har erfaring med at hjælpe mennesker, der står tæt på en person med misbrugsproblemer."
  ]}
  billede="/images/raadgiver.jpg"
  alt="En rådgiver"
  knapTekst="Mød os"
  baggrund="green"
  lysKnap
/>

    </main>

  </PageLayout>

<style is:global>
  :root {
    --green: #244b32;
    --orange: #ed7939;
    --lys-green: #b9cdb4;
    --hvid: #ffffff;
    --tekst: #25392c;
  }




  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }



  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  img {
    display: block;
    max-width: 100%;
  }

  .container {
    width: min(90%, 1100px);
    margin-inline: auto;
  }


  /* HERO */

  .hero {
    min-height: 600px;

    display: flex;
    align-items: center;

    color: white;

    background:
      linear-gradient(
        rgba(25, 45, 30, 0.25),
        rgba(25, 45, 30, 0.45)
      ),
      url("/images/hero.jpg");

    background-size: cover;
    background-position: center;
  }

  .hero-indhold {
    width: min(90%, 1100px);
    margin-inline: auto;
  }

  .hero h1 {
    text-transform: uppercase;
    font-size: clamp(2.8rem, 7vw, 5rem);
    line-height: 0.95;
    font-family: 'DM Sans', sans-serif;
  }

  .hero p {
    max-width: 430px;
  }

  .hero_h2 {
    font-size: 3rem;
    font-family: 'Patrick Hand', cursive;
    text-transform: uppercase;
  

  }


  /* INTRO */

  .intro {
    background: var(--green);
    color: white;
    padding: 5rem 0;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .logo-stor {
    font-size: 7rem;
    text-align: center;
  }


  /* TILBUD */

  .tilbud-sektion {
    background: var(--green);
    color: white;
    padding: 2rem 0 5rem;
  }

  .tilbud-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }


  /* GENERELLE INDHOLDSSEKTIONER */

  .indhold {
    padding: 6rem 0;
  }

  .indhold-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 5rem;
    align-items: center;
  }

  .indhold-grid img {
    width: 100%;
  }

  .indhold h2 {
    font-size: 2rem;
  }

  .lys-baggrund {
    background: var(--lys-green);
  }

  .green-baggrund {
    background: var(--green);
    color: white;
  }

  .orange-baggrund {
    background: var(--orange);
    color: white;
  }


  /* KNAPPER */

  .knap {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.6rem 1rem;

    background: var(--green);
    color: white;

    text-decoration: none;
    text-transform: uppercase;

    font-size: 0.7rem;
    font-weight: bold;
  }

  .knap.lys {
    background: var(--lys-green);
    color: var(--tekst);
  }


  /* MOBIL */

  @media (max-width: 700px) {
    .intro-grid,
    .tilbud-grid,
    .indhold-grid {
      grid-template-columns: 1fr;
    }

    .indhold-grid.omvendt img {
      order: 2;
    }

    .indhold-grid.omvendt .tekst {
      order: 1;
    }

    .hero {
      min-height: 500px;
    }

    .indhold {
      padding: 4rem 0;
    }
  }
</style>
