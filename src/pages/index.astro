---

import Tilbud from "../components/Tilbud.astro";
import Citat from "../components/Citat.astro";
import Indhold from "../components/Indhold.astro";
import PageLayout from "../layout/PageLayout.astro";
import  Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro"
---

 <PageLayout>
    <main>
      <Hero
  titelLinje1="Pårørende"
  titelLinje2="til misbrug"
  undertitel="– hvad gør du nu?"
  tekst="Rådgivingen Orfeus tilbyder gratis rådgivning til pårørende i alle aldre og relationer. Hos RO er vi specialister i at finde den rette støtte til dig."
  knapTekst="Læs mere"
  link="#omos"
/>


     <Intro
  titel="Ingen skal stå alene"
  tekst={[
    "Er du tæt på en person, der har et problematisk forbrug eller et misbrug?",
    "Hos Rådgivningen Orfeus kan du få gratis og anonym rådgivning."
  ]}
  knapTekst="Se vores rådgivning"
  link="/help"
/>

      <!-- TILBUD -->
      <section
        class="tilbud-sektion"
        id="omos"
      >
        <div class="container tilbud-grid">

          <Tilbud
            titel="Online"
            billede="src/assets/online.png"
          >
            Få rådgivning online, hvis du gerne vil kunne
            deltage hjemmefra.
          </Tilbud>

          <Tilbud
            titel="Individuelt"
            billede="src/assets/individuelt.png"
          >
            Få en individuel samtale med fokus på dig og
            din situation.
          </Tilbud>

          <Tilbud
            titel="Gruppe"
            billede="src/assets/gruppe.png"
          >
            Mød andre pårørende og del erfaringer i et
            trygt fællesskab.
          </Tilbud>

        </div>
      </section>


      <!-- CITAT -->
      <Citat
        tekst="Ikke alle mennesker ved, at de er pårørende."
      />
<!-- KENDER DU DET -->
<Indhold
  titel="Kender du det?"
  tekst={[
    
    "Mange pårørende har levet med misbruget så længe, at det er blevet en del af hverdagen. Noget, man tilpasser sig. Noget, man lærer at navigere i uden rigtigt at tænke over det.",
"Måske tæller du genstande. Lytter efter lyden af flasker. Mærker stemningen, så snart du træder ind ad døren. Eller kan høre på stemmen i telefonen, hvordan aftenen kommer til at blive.",
"Nogle ved godt, at de er pårørende. Andre har aldrig tænkt på sig selv sådan – eller har aldrig haft et sprog for det, de oplever.",
"Her kan du spejle dig i andres oplevelser, genkende det, du selv står i, og måske sætte ord på noget, der længe har været svært at forklare.",
"Du er langt fra den eneste. Du er ikke alene.",
  ]}
  billede="src/assets/nogetatspejlesigi.png"
  alt="Person i naturen"
  knapTekst="Bliv klogere"
  link="/spejlet"
  baggrund="lys"
/>


<!-- RÅD OG TIPS -->
<Indhold
  titel="Få råd og tips"
  tekst={[
   "At være pårørende til et menneske med misbrug kan være svært at navigere i. Måske er du i tvivl om, hvad du skal gøre, hvad du kan sige eller hvor dine egne grænser går.",
"Her finder du råd, viden og konkrete værktøjer til dig, der står tæt på misbrug. Om hvordan du kan passe på dig selv, sætte grænser, håndtere svære situationer og være i relationen uden at miste dig selv.",
"Du kan også finde råd til specifikke situationer – når misbruget fylder derhjemme, når du er bekymret, når du skal tage en svær samtale, eller når du bare har brug for at vide, at det, du oplever, ikke er forkert eller unormalt.",
"Du behøver ikke have alle svarene. Her kan du finde hjælp til at tage det næste skridt."
  ]}
  billede="src/assets/ingenskalståalene.png"
  alt="Skygge på en væg"
  knapTekst="Læs mere"
  link="/spejlet"
  baggrund="green"
  omvendt
  lysKnap
/>


<!-- HISTORIER -->

<Indhold
  titel="Personlige historier"

  tekst={[
    "At være pårørende kan se ud på mange forskellige måder. Her møder du ærlige og personlige fortællinger fra mennesker, der lever tæt på misbrug – om det, der fylder, det, der gør ondt, det, de håber på, og det, de har lært undervejs.",

    "Hør om de tanker og følelser, der kan være svære at sætte ord på, og om den forskel RO har gjort. Mød forskellige mennesker og forskellige historier, så du kan genkende noget fra dit eget liv, få nye perspektiver eller måske bare mærke, at du ikke er alene.",

    "Du kan også høre fortællinger fra mennesker, der selv har levet med et misbrug. Få et indblik i deres perspektiv, deres kamp og hvorfor det ikke altid er så enkelt bare at stoppe.",

    "For nogle gange kan en andens historie hjælpe os med at forstå vores egen.",

    "Her kan du læse deres historier og erfaringer."
  ]}

  slideshow={true}

  knapTekst="Hør dem her"
   link="/spejlet"
  baggrund="orange"
/>


<!-- OM FORENINGEN -->
<Indhold
  titel="Om foreningen"
  tekst={[
    "RO står for Rådgivningen Orfeus.",
"Navnet kommer fra den græske myte om Orfeus, der mister sin store kærlighed og begiver sig ned i underverdenen for at hente hende tilbage. En fortælling om at elske et menneske, man har svært ved at nå og om selv at bevæge sig gennem noget mørkt for at holde fast i forbindelsen.",
"Det er et billede på noget, mange pårørende kender. At elske et menneske, samtidig med at misbruget fylder. At håbe, bekymre sig og forsøge at holde fast, også når man selv bliver påvirket af det, der sker.",
"Men hos RO behøver det ikke være så kompliceret.",
"Det første, du møder hos os, er noget langt enklere: lidt RO i en ellers kaotisk situation.",
"Vi rådgiver primært dig, der er pårørende til et menneske med misbrug. Men vi er også her for dig, der selv er i et misbrug og har brug for nogen at tale med.",
"Hos RO behøver du ikke stå alene med det."
  ]}
  billede="src/assets/LOGO3.svg"
  alt="Rådgivningen Orfeus"
  knapTekst="Læs mere"
  link="/about"
  baggrund="lys"
  omvendt
/>

<!-- RÅDGIVER -->
<Indhold
  titel="Mød rådgiverne"
  tekst={[
    "De frivillige rådgivere er rygraden i RO. Det er dem, der hver dag er med til at drive vores rådgivning og gøre en forskel for mennesker, der lever tæt på afhængighed.",
"Vi er en blandet flok med forskellige baggrunde, blandt andet terapeuter, socialrådgivere, sygeplejersker, studerende og meget mere. Vi kommer med forskellige fagligheder og perspektiver, men med det samme ønske: at møde mennesker med forståelse, nærvær og respekt.",
"Størstedelen af vores rådgivere har selv personlige erfaringer med afhængighed i nære relationer. Derfor kan vi trække på både faglig viden og egne erfaringer i rådgivningen.",
"For nogle gange er det netop kombinationen af det faglige og det menneskelige, der gør, at man føler sig set."
  ]}
  billede="src/assets/etmenneskeattalemed.png"
  alt="Ingen skal stå alene"
  knapTekst="Mød os"
  link="/help#raadgivere"
  baggrund="green"
  lysKnap
/>
<!-- FÆLLESSKAB -->
<Indhold
  titel="Fællesskab på facebook"

  tekst={[
    "Har du brug for nogen at snakke med, som forstår, hvordan det er at være tæt på misbrug?",

    "I vores anonyme Facebook-gruppe kan du dele dine tanker og oplevelser, stille spørgsmål og møde andre pårørende, der står i noget af det samme som dig. Du bestemmer selv, hvor meget du vil dele, og du kan være med præcis, som du er.",

    "Et trygt fællesskab, hvor du kan få nye perspektiver, finde genkendelse og mærke, at du ikke står alene med det, der fylder."
  ]}

  billede="src/assets/Fællesskab.png"
  alt="Ingen skal stå alene"

  knapTekst="BLIV EN DEL AF DET HER"
  link="/help"

  baggrund="orange"
  omvendt={true}
/>

    </main>

  </PageLayout>


